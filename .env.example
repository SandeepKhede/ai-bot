# WhatsApp (Meta Cloud API)
WA_ACCESS_TOKEN=           # from Meta developer dashboard
WEBHOOK_VERIFY_TOKEN=      # any random string you choose

# Database
DATABASE_URL=postgresql://wabot:wabot@localhost:5432/wabot

# Redis
REDIS_URL=redis://localhost:6379

# AI
OPENAI_API_KEY=

# Next.js admin portal
NEXTAUTH_SECRET=           # random string
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
# Public HTTPS URL of the Fastify API — required for WhatsApp CTA buttons
API_PUBLIC_URL=https://your-api-domain.com

# ─── Razorpay Subscription Billing ─────────────────────────────────────────────
# Get from https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Webhook secret — set in Razorpay Dashboard → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# Plan IDs — create these in Razorpay Dashboard → Subscriptions → Plans
# Growth: ₹999/month  |  Pro: ₹2,499/month
RAZORPAY_PLAN_GROWTH=plan_xxxxxxxxxxxx
RAZORPAY_PLAN_PRO=plan_xxxxxxxxxxxx

# Same key as RAZORPAY_KEY_ID but exposed to the browser for Razorpay checkout.js
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
